{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "camguessr",
  "compatibility_date": "2026-08-23",
  "main": "./worker.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/media/*",
      "/api/*"
    ]
  },

  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "cam-storage"
    }
  ]
}